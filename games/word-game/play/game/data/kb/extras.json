nment","words":["law","court","judge","jury","trial","lawyer","crime","evidence","verdict","government","parliament","election","vote","citizen","constitution","contract","tax","licence"]},{"id":"spelling","name":"Commonly misspelled words","words":["accommodate","definitely","separate","necessary","receive","occurrence","embarrass","government","environment","calendar","disappear","believe","achieve","beginning","business","changeable","column","committee","conscience","curiosity","discipline","exaggerate","existence","foreign","guarantee","harass","height","immediately","independent","knowledge","library","maintenance","millennium","neighbour","occasion","privilege","pronunciation","questionnaire","recommend","restaurant","rhythm","schedule","successful","tomorrow","unnecessary","weird"]}],"ladders":[["freezing","cold","cool","mild","warm","hot","scorching"],["tiny","small","big","large","huge","enormous"],["content","pleased","happy","delighted","thrilled","ecstatic"],["annoyed","irritated","angry","furious"],["nervous","afraid","scared","terrified"],["slow","steady","quick","fast","rapid"],["dim","bright","brilliant","dazzling"],["like","enjoy","love","adore"],["quiet","soft","loud","deafening"],["sleepy","tired","weary","exhausted"],["fine","good","great","excellent","superb"],["damp","moist","wet","soaked"],["breeze","gust","gale","storm"],["stroll","walk","march","run","sprint"]],"passages":[{"id":"market","level":0,"title":"A Day at the Market","text":"Every Saturday, Amara goes to the market with her mother. The market is busy and loud. People sell fruit, bread, and fish. Amara likes the bright oranges best. Her mother buys rice and milk. They carry the bags home before lunch.","qs":[["What does Amara like best?","The oranges","The fish","The bread"],["When do they go to the market?","On Saturday","Every night","On Monday"]]},{"id":"rain","level":1,"title":"The Long Rain","text":"It rained for three days. The river rose and the fields turned into shallow lakes. Farmers worried about their crops, but the children enjoyed splashing in the puddles. On the fourth morning the clouds broke, and the sun appeared above the wet hills.","qs":[["What happened on the fourth morning?","The clouds broke","The river dried up","It began to rain"],["How did the children feel about the rain?","They enjoyed it","They were afraid","They were angry"]]},{"id":"school","level":2,"title":"Starting at a New School","text":"Moving to a new school can feel overwhelming. Everything is unfamiliar: the corridors, the timetable, even the way people greet one another. Most students find that the first week is the hardest. By the second week they usually recognise a few faces, and the building starts to feel less intimidating.","qs":[["Which week is usually the hardest?","The first","The second","The last"],["What helps the building feel less intimidating?","Recognising faces","A new timetable","Fewer students"]]},{"id":"sleep","level":3,"title":"Why Sleep Matters","text":"Sleep is not simply a pause between busy days. During sleep the brain sorts the day's experiences, strengthens useful memories and clears away waste. People who regularly sleep too little often find it harder to concentrate, to remember new information and to manage their moods. Consistent routines tend to improve both the quantity and the quality of rest.","qs":[["What does the brain do during sleep?","Sorts and strengthens memories","Stops working","Learns new languages"],["What can improve rest?","Consistent routines","Longer working hours","Louder rooms"]]},{"id":"city","level":4,"title":"Cities and Their Neighbourhoods","text":"A large city is rarely a single community. It is a patchwork of neighbourhoods, each with its own character, history and rhythm. Some districts are dominated by offices that empty at night; others thrive after dark. Planners therefore argue that a healthy city mixes housing, work and leisure, so that streets remain lively at every hour.","qs":[["Why do planners favour a mix of housing, work and leisure?","Streets stay lively at all hours","Offices stay full at night","Rents fall"],["What is a city, according to the passage?","A patchwork of neighbourhoods","A single community","An office district"]]},{"id":"trade","level":5,"title":"The Ebb and Flow of Trade","text":"Historians often describe trade as a pendulum rather than a straight line. Periods of openness, in which goods, ideas and people circulate freely, have repeatedly given way to periods of retrenchment, when governments erect barriers in the name of security or self-sufficiency. Yet each retreat has proved temporary, because the benefits of exchange are difficult to renounce for long.","qs":[["Why have retreats from trade proved temporary?","The benefits of exchange are hard to give up","Governments never build barriers","Goods stopped circulating"],["What image do historians use for trade?","A pendulum","A straight line","A fortress"]]}]}